{
  "name": "frlink",
  "version": "0.1.0",
  "description": "Point your coding agent at Friendli's OpenAI- and Anthropic-compatible gateway",
  "type": "module",
  "bin": {
    "frlink": "./dist/bin/frlink.js",
    "frn": "./dist/bin/frlink.js",
    "friendlilink": "./dist/bin/frlink.js",
    "friendlink": "./dist/bin/frlink.js",
    "frnlink": "./dist/bin/frlink.js",
    "frlnk": "./dist/bin/frlink.js",
    "frnlnk": "./dist/bin/frlink.js",
    "frnli": "./dist/bin/frlink.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "dev": "tsx src/bin/frlink.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "cross-keychain": "^1.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0"
}
